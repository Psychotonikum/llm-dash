# llamaDash deployment config (source this / copied into the LXC)
DASH_HOST=0.0.0.0
DASH_PORT=8090

# node poll cadence (seconds) and per-request timeout (seconds)
POLL_INTERVAL=1.5
NODE_TIMEOUT=6

# LiteLLM Postgres — reached over an SSH tunnel (127.0.0.1:15432)
# maintained by a systemd unit in the LXC; adjust host/port for your gateway
PG_HOST=127.0.0.1
PG_PORT=15432
PG_USER=dashro
PG_DB=litellm
# password lives in .dashro.pass (chmod 600); set PG_PASSWORD here to override
PG_PASSWORD=

# api_base prefixes counted as LOCAL (your LAN); everything else = online
LOCAL_PREFIXES=http://192.168.

# Model names that are always LOCAL even when their spend-log api_base is
# empty. Compared normalized (lowercase, alnum only), comma separated.
LOCAL_MODELS=

DATA_DIR=data

# scheduler: enforce load/unload (1) or only preview (0)
SCHEDULE_ENFORCE=1
# scheduler tick (seconds)
SCHEDULE_INTERVAL=20
# how many seconds after a node went offline before we stop acting on it
OFFLINE_GRACE=60
